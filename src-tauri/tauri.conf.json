{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PetX Desktop",
  "version": "0.1.0",
  "identifier": "dev.ichen.petx.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "PetX Desktop",
        "width": 248,
        "height": 276,
        "minWidth": 248,
        "minHeight": 276,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "acceptFirstMouse": true,
        "preventOverflow": true
      },
      {
        "label": "settings",
        "url": "index.html?view=settings",
        "title": "PetX 设置",
        "width": 600,
        "height": 460,
        "minWidth": 520,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visibleOnAllWorkspaces": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "library",
        "url": "index.html?view=library",
        "title": "发现新伙伴",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visibleOnAllWorkspaces": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/pets/**", "$APPCACHE/pet-previews/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A tiny animated PetX companion for your desktop",
    "category": "Entertainment",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
